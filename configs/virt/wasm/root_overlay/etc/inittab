# /etc/inittab for the wasivm kernel, which runs BusyBox init as PID 1.
#
# The kernel provides /dev; mount -a mounts the SkiffOS fstab.
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Start a login shell on the console.
console::respawn:-/bin/sh

# Stop the services and unmount before halt, power-off or reboot.
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
