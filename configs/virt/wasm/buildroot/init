# BusyBox init runs as PID 1 under the wasivm kernel. The root overlay's
# inittab mounts the SkiffOS fstab and starts a login shell on the console.
BR2_INIT_BUSYBOX=y
# BR2_INIT_NONE is not set
# BR2_INIT_SYSTEMD is not set
# BR2_INIT_SYSV is not set
# BR2_TARGET_GENERIC_GETTY is not set
# WASI random_get draws entropy from the host, so there is no pool to seed.
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
