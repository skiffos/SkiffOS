# AXP209 PMIC: power button, battery fuel gauge, charger
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y

# USB MUSB OTG (sun5i uses dedicated sunxi glue driver)
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y

# Display: sun4i/sun5i TCON, HDMI encoder, simple panels
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_HDMI=y
CONFIG_DRM_PANEL_SIMPLE=y

# Audio: sun4i analog codec (headphone/speaker) and I2S
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_SND_SUN4I_I2S=y
