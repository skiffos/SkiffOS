<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GUI</key>
    <dict>
        <key>TextOnly</key>
        <true/>
        <key>Scan</key>
        <dict>
            <key>Entries</key>
            <false/>
            <key>Legacy</key>
            <false/>
            <key>Tool</key>
            <false/>
        </dict>
        <key>Custom</key>
        <dict>
            <key>Entries</key>
            <array>
                <dict>
                    <key>Title</key>
                    <string>SkiffOS for Steam Deck</string>
                    <key>Volume</key>
                    <string>SKIFFOS</string>
                    <key>Path</key>
                    <string>\boot\current\bzImage</string>
                    <key>Type</key>
                    <string>LinuxKernel</string>
