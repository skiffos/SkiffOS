                    <string>\boot\previous\bzImage</string>
                    <key>Type</key>
                    <string>LinuxKernel</string>
                    <key>Arguments</key>
                    <string>root=LABEL=SKIFFOS skiffos.squashfs=/boot/previous/init-skiffos.squashfs rootwait rw init=/boot/previous/skiff-init/skiff-init-squashfs earlyprintk initrd=/boot/amd-ucode.img module_blacklist=tpm amd_iommu=off amdgpu.gttsize=8128 spi_amd.speed_dev=1 audit=0 fbcon=rotate:1</string>
