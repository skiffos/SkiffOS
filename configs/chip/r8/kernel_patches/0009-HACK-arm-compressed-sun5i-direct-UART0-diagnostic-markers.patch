From: SkiffOS <skiffos@skiffos.com>
Date: Tue, 29 Apr 2026 12:00:00 +0200
Subject: [PATCH] HACK: arm: compressed: sun5i direct UART0 diagnostic markers

CONFIG_DEBUG_UNCOMPRESS cannot be enabled with CONFIG_ARCH_MULTIPLATFORM=y
(Kconfig dependency: DEBUG_UNCOMPRESS depends on !ARCH_MULTIPLATFORM).
sunxi_defconfig selects ARCH_MULTIPLATFORM. Result: putc() in misc.c is
a no-op; the decompressor is completely silent. "Uncompressing Linux..."
never appears and we cannot tell if the decompressor runs, hangs, or finishes.

Fix: write directly to sun5i UART1 THR (physical 0x01C28400, offset 0x00)
at four key points. UART TX FIFO is on APB bus -- writes cannot stall on
AHB/MBUS regardless of MBUS state. LSR bit 5 (THRE) polled before each write.

Diagnostic characters on a working path:
  'D' -- BSS cleared, before cache_on/decompress_kernel
  'C' -- decompress_kernel() returned; patch-0006 MBUS settle done
  'F' -- cache_clean_flush() returned; patch-0007 MBUS settle done
  'E' -- __enter_kernel settle done; about to branch to kernel at r4

Interpretation:
  Nothing    -> hang at first zImage instruction (U-Boot settle insufficient)
  'D' only   -> hang inside decompress_kernel; write-through (patch-0008)
                not working; dirty-line burst stalls first post-decomp fetch
  'DC' only  -> hang in get_inflated_image_size or cache_clean_flush
  'DCF' only -> hang in cache_off or first __enter_kernel instruction
                (I-cache just invalidated; patch-0003 settle insufficient)
  'DCFE'     -> decompressor done; hang in real kernel (check DEBUG_LL)

Remove once decompressor stage confirmed working.

Signed-off-by: SkiffOS <skiffos@skiffos.com>
---
--- a/arch/arm/boot/compressed/head.S	2026-04-29 21:10:32.336658857 +0200
+++ b/arch/arm/boot/compressed/head.S	2026-04-29 21:16:42.914127446 +0200
@@ -611,6 +611,27 @@
 		cmp	r2, r3
 		blo	1b
 
+#ifdef CONFIG_MACH_SUN5I
+		/*
+		 * Marker 'D': BSS cleared, before cache_on/decompress. APB write.
+		 * r0=0 (bss loop), r1/r2 scratch.
+		 */
+		mov	r0, #0x01C00000		@ UART1 base (CHIP console)
+		orr	r0, r0, #0x28400
+		mov	r1, #'D'
+sun5i_dbg_d_lsr:
+		ldr	r2, [r0, #0x14]		@ LSR
+		tst	r2, #0x20
+		beq	sun5i_dbg_d_lsr
+		str	r1, [r0]		@ 'D'
+		mov	r1, #'\n'
+sun5i_dbg_d_nl_lsr:
+		ldr	r2, [r0, #0x14]
+		tst	r2, #0x20
+		beq	sun5i_dbg_d_nl_lsr
+		str	r1, [r0]
+#endif
+
 		/*
 		 * Did we skip the cache setup earlier?
 		 * That is indicated by the LSB in r4.
@@ -648,6 +669,24 @@
 sun5i_decomp_settle:
 		subs	r0, r0, #1
 		bne	sun5i_decomp_settle
+		/*
+		 * Marker 'C': decompress_kernel() returned; settle done.
+		 * r0=0, r4=kernel_start, r8=atags. r0-r3 scratch.
+		 */
+		mov	r0, #0x01C00000		@ UART1 base (CHIP console)
+		orr	r0, r0, #0x28400
+		mov	r1, #'C'
+sun5i_dbg_c_lsr:
+		ldr	r2, [r0, #0x14]		@ LSR
+		tst	r2, #0x20
+		beq	sun5i_dbg_c_lsr
+		str	r1, [r0]		@ 'C'
+		mov	r1, #'\n'
+sun5i_dbg_c_nl_lsr:
+		ldr	r2, [r0, #0x14]
+		tst	r2, #0x20
+		beq	sun5i_dbg_c_nl_lsr
+		str	r1, [r0]
 #endif
 
 		get_inflated_image_size	r1, r2, r3
@@ -669,6 +708,24 @@
 sun5i_flush_settle:
 		subs	r0, r0, #1
 		bne	sun5i_flush_settle
+		/*
+		 * Marker 'F': cache_clean_flush() done; settle done.
+		 * I-cache still populated (before cache_off). r0=0, r4=kernel_start.
+		 */
+		mov	r0, #0x01C00000		@ UART1 base (CHIP console)
+		orr	r0, r0, #0x28400
+		mov	r1, #'F'
+sun5i_dbg_f_lsr:
+		ldr	r2, [r0, #0x14]		@ LSR
+		tst	r2, #0x20
+		beq	sun5i_dbg_f_lsr
+		str	r1, [r0]		@ 'F'
+		mov	r1, #'\n'
+sun5i_dbg_f_nl_lsr:
+		ldr	r2, [r0, #0x14]
+		tst	r2, #0x20
+		beq	sun5i_dbg_f_nl_lsr
+		str	r1, [r0]
 #endif
 		bl	cache_off
 
@@ -1498,6 +1555,25 @@
 sun5i_settle:
 		subs	r3, r3, #1
 		bne	sun5i_settle
+		/*
+		 * Marker 'E': __enter_kernel settle done; branching to kernel at r4.
+		 * Caches/MMU OFF. APB write - cannot stall.
+		 * r3=0 (counter). r0/r1 set immediately below.
+		 */
+		mov	r0, #0x01C00000		@ UART1 base (CHIP console)
+		orr	r0, r0, #0x28400
+		mov	r1, #'E'
+sun5i_dbg_e_lsr:
+		ldr	r3, [r0, #0x14]		@ LSR (r3 free)
+		tst	r3, #0x20
+		beq	sun5i_dbg_e_lsr
+		str	r1, [r0]		@ 'E'
+		mov	r1, #'\n'
+sun5i_dbg_e_nl_lsr:
+		ldr	r3, [r0, #0x14]
+		tst	r3, #0x20
+		beq	sun5i_dbg_e_nl_lsr
+		str	r1, [r0]
 #endif
 		mov	r0, #0			@ must be 0
 		mov	r1, r7			@ restore architecture number
